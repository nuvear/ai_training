# ─────────────────────────────────────────────────────────────────────────────
# WorkshopOS environment. Copy to `.env` and fill in.
# Secrets come ONLY from here — never hard-code a key, never commit `.env`.
# The values below marked (dev default) work out-of-the-box with `pnpm db:up`.
# ─────────────────────────────────────────────────────────────────────────────

# --- Database ----------------------------------------------------------------
# App connection. Prisma Client uses this at runtime. Points at the Docker DB
# from docker-compose.yml (port 5433). The app SET LOCAL ROLEs to a non-superuser
# for tenant queries so row-level security is enforced (see src/server/db/rls.ts).
DATABASE_URL="postgresql://workshopos:workshopos@localhost:5433/workshopos?schema=public"

# Direct/superuser connection. Used by `prisma migrate` and by pg-boss (which
# needs to create its own schema). Same DB here in dev; in prod this is the
# unpooled admin URL.
DIRECT_URL="postgresql://workshopos:workshopos@localhost:5433/workshopos?schema=public"

# --- Auth / sessions ---------------------------------------------------------
# Secret used to sign session + magic-link JWTs (HS256). Generate a real one with:
#   openssl rand -base64 32
# (dev default below is NOT secret — replace before any shared/prod use)
AUTH_SECRET="dev-only-insecure-secret-change-me-0000000000000000"

# Base URL the app is served from; magic-link callback URLs are built off it.
APP_URL="http://localhost:3000"

# --- Email (Resend) ----------------------------------------------------------
# When RESEND_API_KEY is set, magic-link emails are sent via Resend.
# When empty (dev default), the magic-link URL is logged to the server console
# instead — no mail server required to sign in locally or in e2e.
RESEND_API_KEY=""
EMAIL_FROM="WorkshopOS <login@workshopos.local>"

# --- Anthropic (copilot / concierge) — needed from M5, stubbed in M0 ----------
# The copilot's language model. Never printed, never logged.
ANTHROPIC_API_KEY=""

# --- Airwallex (commerce) — needed from M2 -----------------------------------
# Airwallex-hosted checkout/Drop-in only; no card data ever touches our servers.
# Sandbox: AIRWALLEX_ENV=demo. Get client_id + API key from the Airwallex
# dashboard (Developer → API keys). The webhook secret is generated when you
# register the webhook endpoint (Developer → Webhooks) — see /api/webhooks/airwallex.
AIRWALLEX_ENV="demo"
AIRWALLEX_CLIENT_ID=""
AIRWALLEX_API_KEY=""
AIRWALLEX_WEBHOOK_SECRET=""

# 適格請求書 (qualified invoice) registration number to print on invoices.
# ⚠ OPEN (PRODUCT_SPEC §4.2) — supplied by the owner; leave blank until then.
QUALIFIED_INVOICE_NO=""

# --- Observability (M6 §4) ---------------------------------------------------
# Optional Sentry DSN for error tracking. When set, captureError() forwards
# unhandled 500s to Sentry; when blank it is a structured-log-only no-op.
# SENTRY_DSN=""
